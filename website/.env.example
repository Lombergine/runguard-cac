# Copy to .env.local and fill in. Every value below is optional for local dev:
# with none of them set the site runs on SQLite with the built-in rule engine.

# --- database -------------------------------------------------------------
# "sqlite" (default) uses website/data/milemarker.db — no credentials needed.
# "supabase" fails closed if the password is missing; it never falls back.
DB_DRIVER=
# Supabase only. See DEPLOY.md.
DB_HOST=
DB_PORT=
DB_USER=
DB_NAME=
DB_PASSWORD=

# --- sessions -------------------------------------------------------------
# Required in production. Unset on SQLite + non-prod, a published dev fallback
# is used, so local dev works without this.
SESSION_SECRET=

# --- coach ----------------------------------------------------------------
# Unset behaves as "ollama". Set to "anthropic" to use the hosted coach —
# that is what starts sending a de-identified athlete digest to Anthropic.
COACH_PROVIDER=
# Only read when COACH_PROVIDER=anthropic. Use your own key.
ANTHROPIC_API_KEY=
# 1 = no question ever reaches a model. Safety intercepts still run.
DEMO_MODE=
# Local coach model, used when COACH_PROVIDER is unset or "ollama".
OLLAMA_MODEL=
OLLAMA_BASE_URL=

# --- misc -----------------------------------------------------------------
# Enables the "Explore the demo team" button on /login. Gated server-side to
# SQLite + non-production, so it does nothing on a deployment.
COACH_PASSWORD=
NEXT_PUBLIC_SITE_URL=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_VERIFY_TOKEN=
STRAVA_SUBSCRIPTION_ID=
