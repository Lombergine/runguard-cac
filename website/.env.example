# RunGuard — environment.
#
# Copy to `.env.local` for local development. On Vercel these go in
# Settings → Environment Variables. Nothing here is a real value.

# ── Required in any deployment ───────────────────────────────────────────────

# Signs the coach session cookie. Generate with: openssl rand -hex 32
#
# NOT OPTIONAL once deployed. src/lib/session.ts throws rather than falling back
# to the published dev default the moment DB_DRIVER=supabase or NODE_ENV=production,
# because that default is a string anyone can read in this repository — and a
# session cookie signed with a public secret is a session anyone can mint.
SESSION_SECRET=

# ── Database ─────────────────────────────────────────────────────────────────

# Unset (or "sqlite") uses the local file and needs nothing else.
# "supabase" talks to Postgres and needs a password or a full URL.
DB_DRIVER=supabase
DB_PASSWORD=
# DATABASE_URL=            # alternative to DB_PASSWORD; a full connection string

# ── The public demo ──────────────────────────────────────────────────────────

# The team the "See the coach dashboard" link opens, read-only. UNSET = no demo:
# the routes 404 and the landing page hides the buttons.
#
# THE TEAM YOU POINT THIS AT IS PUBLIC. Anyone with the link reads its roster,
# its check-ins and its injuries. It must contain seeded data only — the moment a
# real athlete joins it, every visitor is reading a real minor's health record.
# Nothing in code can check that for you.
#
# Read at BUILD time by the landing page, which is statically prerendered, so
# changing it needs a redeploy rather than just a restart.
DEMO_TEAM_ID=1

# Optional: which runner the athlete demo opens as. Unset picks the first on the
# demo roster alphabetically. Checked against that roster, so pointing it at an
# athlete on another team falls back rather than leaking their session.
# DEMO_ATHLETE_ID=

# ── Optional ─────────────────────────────────────────────────────────────────

# Absolute site URL. Only used to build Open Graph image URLs — link previews
# break without it, nothing else does.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# The AI coach. UNSET IS A WORKING CONFIGURATION: src/lib/coach.ts answers from
# its own rule engine, which costs nothing and is what every fallback path
# returns anyway. Set this only when you want model-written replies, and know
# that /api/chat is reachable by every demo visitor (rate-limited to 12/min/IP).
# ANTHROPIC_API_KEY=
=======
# Copy to .env.local and fill in. Every value below is optional for local dev:
# with none of them set the site runs on SQLite with the built-in rule engine.

# --- database -------------------------------------------------------------
# "sqlite" (default) uses website/data/milemarker.db — no credentials needed.
# "supabase" fails closed if the password is missing; it never falls back.
DB_DRIVER=
# Supabase only. See DEPLOY.md.
DB_HOST=
DB_PORT=
DB_USER=
DB_NAME=
DB_PASSWORD=

# --- sessions -------------------------------------------------------------
# Required in production. Unset on SQLite + non-prod, a published dev fallback
# is used, so local dev works without this.
SESSION_SECRET=

# --- coach ----------------------------------------------------------------
# Unset behaves as "ollama". Set to "anthropic" to use the hosted coach —
# that is what starts sending a de-identified athlete digest to Anthropic.
COACH_PROVIDER=
# Only read when COACH_PROVIDER=anthropic. Use your own key.
ANTHROPIC_API_KEY=
# 1 = no question ever reaches a model. Safety intercepts still run.
DEMO_MODE=
# Local coach model, used when COACH_PROVIDER is unset or "ollama".
OLLAMA_MODEL=
OLLAMA_BASE_URL=

# --- misc -----------------------------------------------------------------
# Enables the "Explore the demo team" button on /login. Gated server-side to
# SQLite + non-production, so it does nothing on a deployment.
COACH_PASSWORD=
NEXT_PUBLIC_SITE_URL=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_VERIFY_TOKEN=
STRAVA_SUBSCRIPTION_ID=
