# RunGuard — website environment.
#
# Copy to `.env.local` for local development. On Vercel these go in
# Settings → Environment Variables. No values here, only names.
#
# EVERY VARIABLE BELOW IS ONE THE CODE ACTUALLY READS. That is the whole point of
# this file, and it is worth keeping true: an earlier copy listed STRAVA_CLIENT_ID,
# COACH_PROVIDER, DEMO_MODE and ANTHROPIC_API_KEY, none of which are read anywhere
# in src/ — Strava was removed from the product, and the coach model is Ollama.
# Documenting a variable that does nothing is worse than not documenting it: it
# sends whoever is deploying to look for the feature it implies.
#
# Nothing is required for local dev. With none of these set the site runs on the
# local SQLite file with the built-in rule engine.

# ── Database ─────────────────────────────────────────────────────────────────

# "sqlite" (default) uses website/data/milemarker.db and needs nothing else.
# "supabase" fails closed if the password is missing — it never falls back.
DB_DRIVER=
# Supabase only. Either DB_PASSWORD with the defaults, or a full DATABASE_URL.
DB_PASSWORD=
# DATABASE_URL=
DB_HOST=
DB_PORT=
DB_USER=
DB_NAME=
# Override where the SQLite file lives. Rarely needed.
# DATABASE_PATH=

# ── Sessions ─────────────────────────────────────────────────────────────────

# Signs the coach session cookie. Generate with: openssl rand -hex 32
#
# REQUIRED once deployed. src/lib/session.ts throws rather than falling back to
# the published dev default the moment DB_DRIVER=supabase or NODE_ENV=production,
# because that default is a string anyone can read in this repository — and a
# session signed with a public secret is a session anyone can mint.
SESSION_SECRET=

# ── The public demo ──────────────────────────────────────────────────────────

# The team the "See the coach dashboard" link opens, read-only. UNSET = no demo:
# the routes 404 and the landing page hides the buttons.
#
# THE TEAM YOU POINT THIS AT IS PUBLIC. Anyone with the link reads its roster,
# its check-ins and its injuries. It must contain seeded data only — the moment a
# real athlete joins it, every visitor is reading a real minor's health record.
# No code can check that for you.
#
# Read at BUILD time by the landing page, which is statically prerendered, so
# changing it needs a redeploy rather than just a restart.
DEMO_TEAM_ID=

# Optional: which runner the athlete demo opens as. Unset picks the first on the
# demo roster alphabetically. Checked against that roster, so pointing it at an
# athlete on another team falls back rather than leaking their session.
DEMO_ATHLETE_ID=

# Separate and much older: a password-only shortcut on /login. It exists ONLY
# against local SQLite outside production (see demoPassword() in
# api/login/route.ts), so it does nothing on a deployment. DEMO_TEAM_ID above is
# the one that produces the public demo.
COACH_PASSWORD=

# ── The coach chat ───────────────────────────────────────────────────────────
#
# DO NOT SET EITHER OF THESE ON VERCEL. They point at an Ollama server on
# localhost, which does not exist on a serverless deployment — setting them there
# buys a timeout on every question before the fallback runs.
#
# Unset is the deployed configuration, and it is a complete one: src/lib/coach.ts
# is a no-op without OLLAMA_MODEL and every question is answered by the rule
# engine in src/lib/chat.ts, reading that athlete's own last 14 days. That engine
# is also what every failure path returns, so it is the thing that has to be good
# regardless.
#
# There is no hosted-model option wired up. No code in src/ reads
# ANTHROPIC_API_KEY or any other provider key — if you want one, it has to be
# built, not configured.
#
# /api/chat is reachable by every demo visitor, rate-limited to 12/min/IP.
#
# LOCAL DEVELOPMENT ONLY:
# OLLAMA_MODEL=
# OLLAMA_BASE_URL=          # defaults to http://localhost:11434

# ── Misc ─────────────────────────────────────────────────────────────────────

# Absolute site URL. Only used to build Open Graph image URLs — link previews
# break without it, nothing else does.
NEXT_PUBLIC_SITE_URL=

# Lets `npm run seed` wipe a database that holds rows it did not create. Leave
# unset; the guard exists because a reseed is not recoverable.
# SEED_FORCE=
