# Copy to .env and fill in. Both are read only in development (__DEV__).

# Where the website is running. localhost works from the iOS Simulator, which
# shares the Mac's loopback; on a physical phone use your Mac's LAN IP
# (e.g. http://10.0.0.5:3000).
EXPO_PUBLIC_API_URL=

# Skips the login screen in dev. A device token is a full credential — it reads
# that athlete's profile — so generate your own with `npm run seed` in website/
# and never reuse someone else's.
EXPO_PUBLIC_DEV_TOKEN=
